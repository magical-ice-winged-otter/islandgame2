script ISLANDGAME_AETHERIA_IceCreamLady {
    lock
    faceplayer
    showmoneybox(18, 1)
    msgbox(format(
        "Helloooooo! Would you like some frosty Nice Cream? It's only ¥500 for a cone!"
    ), MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        checkmoney(500)
        if(var(VAR_RESULT)) {
            removemoney(500)
            updatemoneybox
            playse(SE_SHOP)
            waitse
            playse(SE_VEND)
            waitse
            hidemoneybox
            msgbox(format(
                "Enjoy!"
            ))
            giveitem(ITEM_CASTELIACONE)
        }
        else {
            msgbox(format(
                "Oh... you don't have enough money."
            ))
        }
    }
    hidemoneybox
    closemessage
    release
}


